# Local development defaults. For production (Hostinger Node.js App), set
# these as actual values in hPanel → Websites → [api app] → Environment
# variables — do NOT commit a real .env file (it's gitignored already).

PORT=4000
NODE_ENV=development
# Local dev: a local/Docker MongoDB. Production: a MongoDB Atlas URI
# (Hostinger's Node.js App hosting doesn't include a managed MongoDB).
MONGO_URI=mongodb://127.0.0.1:27017/feastgo
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Must match the deployed frontend's exact origin (used for both CORS and
# the Socket.IO handshake). Production: https://feastgo.zenovik.com
CLIENT_ORIGIN=http://localhost:4200
